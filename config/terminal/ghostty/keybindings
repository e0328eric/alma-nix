keybind = ctrl+comma=open_config
keybind = ctrl+shift+r=reload_config

keybind = ctrl+enter=toggle_fullscreen

keybind = ctrl+shift+a=select_all
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
keybind = shift+insert=paste_from_selection

keybind = ctrl+shift+n=new_window

keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+zero=reset_font_size

keybind = ctrl+shift+page_down=jump_to_prompt:1
keybind = ctrl+shift+page_up=jump_to_prompt:-1

#                          ╭────────────────────────╮
#                          │ Spilt related settings │
#                          ╰────────────────────────╯
keybind = alt+shift+s=new_split:down
keybind = alt+shift+d=new_split:right
keybind = alt+ctrl+shift+plus=equalize_splits

keybind = alt+ctrl+shift+a=resize_split:left,10
keybind = alt+ctrl+shift+d=resize_split:right,10
keybind = alt+ctrl+shift+s=resize_split:down,10
keybind = alt+ctrl+shift+w=resize_split:up,10


# goto_split
keybind = ctrl+shift+a=goto_split:left
keybind = ctrl+shift+d=goto_split:right
keybind = ctrl+shift+s=goto_split:down
keybind = ctrl+shift+w=goto_split:up

keybind = alt+ctrl+right_bracket=goto_split:next
keybind = alt+ctrl+left_bracket=goto_split:previous

#                           ╭──────────────────────╮
#                           │ Tab related settings │
#                           ╰──────────────────────╯
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+q=close_tab

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# goto_tab
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+six=goto_tab:6
keybind = alt+seven=goto_tab:7
keybind = alt+eight=goto_tab:8

# adjust selection
keybind = shift+left=adjust_selection:left
keybind = shift+right=adjust_selection:right
keybind = shift+down=adjust_selection:down
keybind = shift+up=adjust_selection:up

keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = shift+home=scroll_to_top
keybind = shift+end=scroll_to_bottom

# inspector
keybind = ctrl+shift+i=inspector:toggle

# do nothing
keybind = alt+f4=ignore
keybind = ctrl+shift+left=ignore
keybind = ctrl+page_up=ignore
keybind = ctrl+page_down=ignore
keybind = ctrl+shift+right=ignore

