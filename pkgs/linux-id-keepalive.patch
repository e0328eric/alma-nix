@@ -0,0 +1,78 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/matejsmycka/linux-id/fidohid"
+)
+
+type keepaliveResponder struct {
+	fakeResponder
+	statuses    []byte
+	onKeepalive func(byte) error
+}
+
+func (f *keepaliveResponder) WriteKeepalive(_ context.Context, _ fidohid.AuthEvent, status byte) error {
+	f.statuses = append(f.statuses, status)
+	if f.onKeepalive != nil {
+		return f.onKeepalive(status)
+	}
+	return nil
+}
+
+func TestKeepaliveWhileWaitingForFingerprint(t *testing.T) {
+	for _, ok := range []bool{true, false} {
+		t.Run(map[bool]string{true: "match", false: "no match"}[ok], func(t *testing.T) {
+			results := make(chan VerifyResult, 1)
+			response := &keepaliveResponder{}
+			response.onKeepalive = func(status byte) error {
+				// Deliver the scan only after multiple progress packets. This
+				// models a person who needs time to reach the fingerprint reader.
+				if len(response.statuses) == 3 {
+					results <- VerifyResult{OK: ok, Reason: ReasonNoMatch}
+				}
+				return nil
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			defer cancel()
+			result, err := waitForVerification(ctx, response, fidohid.AuthEvent{}, results)
+			if err != nil || result.OK != ok || result.Reason != ReasonNoMatch {
+				t.Fatalf("scan result changed: %+v, %v", result, err)
+			}
+			for _, status := range response.statuses[:3] {
+				if status != 2 {
+					t.Fatalf("expected UPNEEDED while waiting, got %d", status)
+				}
+			}
+			if ok && (len(response.statuses) != 4 || response.statuses[3] != 1) {
+				t.Fatalf("expected PROCESSING after successful scan: %v", response.statuses)
+			}
+			if !ok && len(response.statuses) != 3 {
+				t.Fatalf("failed scan must not continue processing: %v", response.statuses)
+			}
+		})
+	}
+}
+
+func TestKeepaliveDoesNotAuthenticateOnTimeout(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Millisecond)
+	defer cancel()
+	result, err := waitForVerification(ctx, &keepaliveResponder{}, fidohid.AuthEvent{}, make(chan VerifyResult))
+	if result.OK || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("expected timeout without authentication, got %+v, %v", result, err)
+	}
+}
+
+func TestKeepaliveWriteFailureDeniesAuthentication(t *testing.T) {
+	disconnected := errors.New("HID device disconnected")
+	response := &keepaliveResponder{onKeepalive: func(byte) error { return disconnected }}
+	results := make(chan VerifyResult, 1)
+	results <- VerifyResult{OK: true}
+	result, err := waitForVerification(context.Background(), response, fidohid.AuthEvent{}, results)
+	if result.OK || !errors.Is(err, disconnected) {
+		t.Fatalf("expected failed transport without authentication, got %+v, %v", result, err)
+	}
+}
