+// WriteKeepalive sends a HID status packet, not a final CBOR response.
+func (t *SoftToken) WriteKeepalive(ctx context.Context, evt AuthEvent, status byte) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	return t.writeResponse(evt.chanID, CmdKeepalive, []byte{status}, 0)
+}
+
+// Keep each complete response together when the HID loop handles INIT while
+// the server is sending a keepalive or a multi-packet credential response.
+func (t *SoftToken) writeResponse(channel uint32, cmd CmdType, data []byte, status uint16) error {
+	t.writeMu.Lock()
+	defer t.writeMu.Unlock()
+	return writeRespose(t.device, channel, cmd, data, status)
