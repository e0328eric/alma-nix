+// Chromium times out an idle HID transaction before a fingerprint scan's
+// deadline. CTAPHID_KEEPALIVE (UPNEEDED) tells it to keep waiting for the user.
+func waitForVerification(ctx context.Context, token tokenResponder, evt fidohid.AuthEvent, results <-chan VerifyResult) (VerifyResult, error) {
+	ticker := time.NewTicker(100 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if err := token.WriteKeepalive(ctx, evt, 2); err != nil {
+			return VerifyResult{}, err
+		}
+		select {
+		case result := <-results:
+			if result.OK {
+				// The remaining TPM work is processing, not a new touch request.
+				if err := token.WriteKeepalive(ctx, evt, 1); err != nil {
+					return VerifyResult{}, err
+				}
+			}
+			return result, nil
+		case <-ctx.Done():
+			return VerifyResult{}, ctx.Err()
+		case <-ticker.C:
+		}
+	}
 }
 
